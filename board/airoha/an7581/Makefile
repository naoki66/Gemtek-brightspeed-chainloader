# One SoC (AN7581), multiple Gemtek board variants. Pick the board-specific
# C file at build time via the symbol set in each defconfig, following the
# uboot-an758x multi-board pattern (per-board defconfig + env + DTS).
obj-$(CONFIG_BOARD_XR1710G) += xr1710g_rfb.o
obj-$(CONFIG_BOARD_XG2010G) += xg2010g_rfb.o
